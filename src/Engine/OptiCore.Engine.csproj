<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>OptiCore.Engine</RootNamespace>
    <AssemblyName>OptiCore.Engine</AssemblyName>
    <!-- Pulls in the Windows Desktop shared framework (System.Drawing, EventLog, PerformanceCounter). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <InternalsVisibleTo Include="OptiCore.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <PackageReference Include="System.Management" Version="11.0.0" />
  </ItemGroup>
</Project>
