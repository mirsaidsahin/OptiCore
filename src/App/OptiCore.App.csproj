<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>OptiCore.App</RootNamespace>
    <AssemblyName>OptiCore</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\opticore.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The WebView2 package also references its WPF control; it is unused here and its WindowsBase version note is harmless. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <ProjectReference Include="..\Engine\OptiCore.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Development builds read the UI from the folder next to the exe (edit and reload). -->
    <Content Include="ui\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <!-- Published builds carry the UI inside OptiCore.exe, so the program is a single file. -->
    <EmbeddedResource Include="ui\**\*" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\opticore.ico" LogicalName="opticore.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
</Project>
