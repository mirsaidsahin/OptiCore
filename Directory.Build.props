<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;CS8981;SYSLIB1054;SYSLIB1096;CA2101</NoWarn>

    <Version>0.3.0</Version>
    <Product>OptiCore</Product>
    <Company>OptiCore</Company>
    <Copyright>OptiCore</Copyright>

    <!-- Build output goes to ./artifacts by default. Set the OPTICORE_ARTIFACTS
         environment variable to redirect it (useful when the repo lives in a very deep path). -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(OPTICORE_ARTIFACTS)' != ''">$(OPTICORE_ARTIFACTS)</ArtifactsPath>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>
</Project>
